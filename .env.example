# ---------------------------------------------------------------------------
# Cấu hình Supabase (bắt buộc)
# ---------------------------------------------------------------------------
# Lấy tại: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL         = Project URL          (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_KEY = service_role secret  (mục "Project API keys")
#
# ⚠️  service_role key có TOÀN QUYỀN trên database. Chỉ dùng ở backend,
#     tuyệt đối không đưa vào mã chạy trên trình duyệt.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Tùy chọn
# ---------------------------------------------------------------------------
# Khóa ký JWT. Nếu để trống sẽ sinh ngẫu nhiên mỗi lần khởi động
# (mọi token cũ sẽ mất hiệu lực khi restart).
JWT_SECRET=

# Thời hạn token, giây (mặc định 12 giờ)
JWT_TTL_SECONDS=43200

# Cổng máy chủ (mặc định 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Trợ lý AI (tùy chọn)
# ---------------------------------------------------------------------------
# Bóng chat AI trên trang Tổng quan mặc định dùng bộ parse lệnh tiếng Việt
# (miễn phí, chạy offline). Nếu điền OPENAI_API_KEY, trợ lý sẽ hiểu ngôn ngữ
# tự nhiên qua LLM (OpenAI, hoặc endpoint tương thích OpenAI khác).
#   OPENAI_API_KEY   khóa API (để trống = dùng parse lệnh)
#   OPENAI_MODEL     mô hình (mặc định gpt-4o-mini)
#   OPENAI_BASE_URL  endpoint tương thích (mặc định https://api.openai.com/v1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
