# ---------------------------------------------------------------------------
# Cấu hình Supabase (bắt buộc)
# ---------------------------------------------------------------------------
# Lấy tại: Supabase Dashboard → Project Settings → API
#   SUPABASE_URL         = Project URL          (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_KEY = service_role secret  (mục "Project API keys")
#
# ⚠️  service_role key có TOÀN QUYỀN trên database. Chỉ dùng ở backend,
#     tuyệt đối không đưa vào mã chạy trên trình duyệt.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Tùy chọn
# ---------------------------------------------------------------------------
# Khóa ký JWT. Nếu để trống sẽ sinh ngẫu nhiên mỗi lần khởi động
# (mọi token cũ sẽ mất hiệu lực khi restart).
JWT_SECRET=

# Thời hạn token, giây (mặc định 12 giờ)
JWT_TTL_SECONDS=43200

# Cổng máy chủ (mặc định 3000)
PORT=3000
